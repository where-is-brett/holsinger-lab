# Defaults, used by ./intro-template and can be deleted if the component is removed
NEXT_PUBLIC_VERCEL_GIT_REPO_OWNER="sanity-io"
NEXT_PUBLIC_VERCEL_GIT_PROVIDER="github"
NEXT_PUBLIC_VERCEL_GIT_REPO_SLUG="nextjs-personal-website-cms-sanity-v3"

# Required. These two are the ONLY variables `next build`, `npm run test:e2e`
# and `npm run dev` actually require -- everything else below is optional for
# local work. They are not secrets: the project ID appears in every image URL
# the public site serves (cdn.sanity.io/images/j3f9z8os/production/...), and the
# dataset is publicly readable. Prefilled so a fresh clone or a remote/cloud
# session can `cp .env.local.example .env.local` and immediately build and run
# the e2e suite.
NEXT_PUBLIC_SANITY_PROJECT_ID=j3f9z8os
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Only needed to read drafts/unpublished content via Presentation.
# Public reads work without it (lib/sanity.api.ts defaults it to '').
SANITY_API_READ_TOKEN=
# Optional, and deliberately left unset for development worktrees: without it
# nothing in this checkout can write to the live dataset, which is a constraint
# the redesign work relies on (docs/redesign-experiment/phase-1-decisions.md).
SANITY_API_WRITE_TOKEN=

# Required for /api/revalidate to accept Sanity webhook calls; the route
# fails closed (401s) when unset. Set this to the same secret configured on
# the Sanity webhook itself (see https://www.sanity.io/docs/webhooks).
SANITY_WEBHOOK_SECRET=

# Optional, can be used to change the Studio title in the navbar and differentiate between production and staging environments for your editors
NEXT_PUBLIC_SANITY_PROJECT_TITLE="HOLSINGER LAB"

# The canonical production URL. Used for canonical tags, Open Graph/Twitter
# URLs, the sitemap, and the contact form's same-origin check. Defaults to
# this project's Vercel domain if unset.
NEXT_PUBLIC_SITE_URL="https://holsingerlab.vercel.app"

# Formspree form ID (the part after https://formspree.io/f/ in your form's endpoint)
FORMSPREE_ENDPOINT=
