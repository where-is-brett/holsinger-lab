  "projects": [
    {
      "key": "fecal-microbiota-transplantation",
      "sanityId": "8b33e77a-524f-4b80-9dfa-3ed6e4994f2f",
      "researchOrder": 1,
      "title": "Fecal microbiota transplantation as a treatment for Alzheimer's disease",
      "paragraphs": [
        "The gut microbiome has been implicated in numerous neurodegenerative diseases. We were the first to demonstrate that modulation of the gut microbiome of Alzheimer's disease (AD) mice results in improved cognition and pathology (Left - non-treated; Right - treated for 7 days). We are now investigating mechanisms driving these changes in the brain as they will highlight therapeutic avenues for disease modification."
      ],
      "imageUrl": "https://static.wixstatic.com/media/48c693_1a8d3760efaa4c669b6b1bcca9623b7e~mv2.png",
      "imageAlt": "Brain tissue from an Alzheimer's disease mouse: left non-treated, right treated for 7 days"
    },
    {
      "key": "glial-activity",
      "sanityId": "639c1dd4-f4db-439b-85f6-18062558d6df",
      "researchOrder": 2,
      "title": "Glial activity as a marker of disease",
      "paragraphs": [
        "Astrocytes and microglia play an important role in the maintenance of a homestatic environment in the brain. They aid in the clearance of dead and dying cells, preventing inflammatory reactions in the brain. During Alzheimer's disease, these two classes of cells turn rogue and contribute to disease pathology."
      ],
      "imageUrl": "https://static.wixstatic.com/media/48c693_6a80376bafcb4e6c902f061083ade1cf~mv2.png",
      "imageAlt": "Fluorescence microscopy of astrocytes and microglia"
    },
    {
      "key": "functionalization-of-biological-scaffolds",
      "sanityId": null,
      "researchOrder": 3,
      "title": "Functionalization of biological scaffolds employing trophic factors released from mammalian cells",
      "paragraphs": [
        "Trophic factors released from mammalian cells enhance their ability to support tissue repair and regeneration. These naturally derived signalling molecules promote cell survival, proliferation and differentiation, creating a bioactive microenvironment that encourages healing while improving the scaffold's capacity to integrate with surrounding tissue."
      ],
      "imageUrl": null,
      "imageAlt": ""
    },
    {
      "key": "neurotrophic-factors-nervous-system",
      "sanityId": null,
      "researchOrder": 4,
      "title": "Neurotrophic factors for the differentiation and regeneration of the nervous system",
      "paragraphs": [
        "Neurotrophic factors are essential signalling molecules that support the growth, survival and differentiation of neurons. By incorporating these bioactive molecules into regenerative therapies, we aim to enhance nerve repair, promote functional recovery and create favourable environments for nervous system regeneration following injury or disease."
      ],
      "imageUrl": null,
      "imageAlt": ""
    }
  ],
