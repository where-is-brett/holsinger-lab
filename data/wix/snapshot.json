    "about": {
      "heading": "About the Laboratory",
      "paragraphs": [
        "The Holsinger Laboratory investigates the molecular and cellular mechanisms underlying Alzheimer's disease and related neurodegenerative disorders. Our research combines molecular neuroscience, neuroinflammation, and translational biology to identify novel therapeutic strategies that slow disease progression and improve brain health."
      ],
      "themesIntro": "Our research focus rests on the following broad themes:",
      "themes": [
        {
          "key": "alzheimers-disease",
          "title": "Alzheimer's disease",
          "summary": "- Understanding the molecular pathways driving neurodegeneration"
        },
        {
          "key": "neuroinflammation",
          "title": "Neuroinflammation",
          "summary": "- Investigating astrocytes, microglia and inflammatory signalling"
        },
        {
          "key": "therapeutic-development",
          "title": "Therapeutic development",
          "summary": "- Developing novel treatments to improve neuronal survival and function"
        }
      ]
    },
    "teamIntro": "Our team members are at the core of what makes the Holsinger Lab such a unique, fun and fulfilling place to work. We take pride in the talents of our team, with each member contributing their unique skills to our projects.",
