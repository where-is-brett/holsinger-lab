{
  "name": "holsinger-lab",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "backfill:profile-role-groups": "node scripts/backfill-profile-role-groups.ts",
    "backfill:publication-dois": "node scripts/backfill-publication-dois.ts",
    "build": "next build",
    "dev": "next dev",
    "format": "npx prettier --write . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "typegen": "sanity schema extract --force && sanity typegen generate"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@portabletext/react": "7.0.1",
    "@sanity/client": "7.26.2",
    "@sanity/color-input": "^6.1.3",
    "@sanity/image-url": "2.1.1",
    "@sanity/orderable-document-list": "2.0.20",
    "@sanity/ui": "^3.5.2",
    "next": "16.3.1",
    "next-sanity": "13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.9.2",
    "sanity-plugin-asset-source-unsplash": "7.0.23",
    "sanity-plugin-media": "6.1.4",
    "styled-components": "6.5.3",
    "suspend-react": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/styled-components": "^5.1.36",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "prettier-plugin-packagejson": "^2.4.3",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.1.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
